                    pre.larger-font.fragment data-id="compile-time-cart-implemetation" 
                        code.hljs.cpp data-trim="" data-line-numbers=""
                            script type="text/template"
                                |
                                    template <typename... Bags> // Bag<Apple>, Bag<Banana>, etc...
                                    struct Cart {
                                        // ...
                                    private:
                                        std::tuple<Bags...> m_bags;
                                        // Will be expanded to std::tuple<Bag<Apple>, Bag<Banana>, ...> m_bags;
                                    };

                section data-auto-animate=""
                    h2 Cart Implementation Time
                    pre.larger-font.fragment data-id="compile-time-cart-implemetation" 
                        code.hljs.cpp data-trim="" data-line-numbers="3|4-6|8-13|15-18|20-26|21|22|23|24|21-25|28-38|29-35|30|31|32-34|29,35|37"
                            script type="text/template"
                                |
                                    template <typename... Bags> // Bag<Apple>, Bag<Banana>, etc...
                                    struct Cart {
                                        constexpr Cart(Bags... bags) : m_bags{bags...} {}
                                        // Helper for operator+
                                        constexpr Cart(std::tuple<Bags...> bags_tuple)
                                                    : m_bags(std::move(bags_tuple)) {}

                                        template <typename... OtherBags>
                                        constexpr auto operator+(OtherBags... bags) const {
                                            return Cart<Bags..., OtherBags...>(
                                                std::tuple_cat(m_bags, std::make_tuple(bags...))
                                            );
                                        }

                                        template <typename BagT>
                                        static constexpr double BagPrice(const BagT& bag) {
                                            return bag.size() * bag[0].price;
                                        }

                                        constexpr double TotalCost() const {
                                            return ( // fold-expression
                                                BagPrice(std::get<Bags>(m_bags)) // expression to expand
                                                + ... // expanding
                                                + 0.0 // initial value
                                                );
                                        }

                                        void Receipt() const {
                                            ([&]() {
                                                const auto& bag = std::get<Bags>(m_bags); // std::array inheritance
                                                const auto& firstItem = bag.front();
                                                std::cout << firstItem.GetName() << "s: "
                                                        << bag.size() << " 💰: " << firstItem.price
                                                        << "\n";
                                            }(), ...);
                                            
                                            std::cout << "Total: " << TotalCost() << "\n";
                                        }

                                    private:
                                        std::tuple<Bags...> m_bags;
                                    };


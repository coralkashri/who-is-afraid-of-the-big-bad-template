                section 
                    h2 What is std::tuple?
                    ul
                        li.fragment tuple is an extended std::pair, can hold an inifinite number of types.
                        li.fragment The choise to which element we want to access should be done at compile-time.
                    pre.larger-font.fragment 
                        code.hljs.cpp data-trim="" data-line-numbers="|4"
                            script type="text/template"
                                |
                                    std::tuple<int, double, std::string> myTuple;
                                    std::get<0>(myTuple); // 1. Access to int
                                    std::get<2>(myTuple); // 2. Access to std::string
                                    std::get<double>(myTuple); // 3. Access to double
                    h4.fragment When using typed get access, all the tuple's types have to be unique.
                    pre.larger-font.fragment 
                        code.hljs.cpp data-trim="" data-line-numbers=""
                            script type="text/template"
                                |
                                    std::tuple<int, double, int> myTuple;
                                    std::get<int>(myTuple); // Compile-time error.

                section data-auto-animate=""
